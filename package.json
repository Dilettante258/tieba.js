{
	"name": "@tieba/sdk",
	"version": "3.0.0",
	"type": "module",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"scripts": {
		"build": "tsc --emitDeclarationOnly --outDir dist",
		"dev": "tsc --emitDeclarationOnly --outDir dist --watch",
		"proto:gen": "bun run scripts/proto-gen.ts",
		"typecheck": "tsc --noEmit",
		"test": "bun test test/*.test.ts",
		"test:integration": "bun test test/integration/",
		"docs": "typedoc"
	},
	"dependencies": {
		"@bufbuild/protobuf": "^2.11.0",
		"effect": "^3.14.11",
		"long": "^5.2.4",
		"node-html-parser": "^6.1.13",
		"undici": "^7.8.0"
	},
	"devDependencies": {
		"ts-proto": "^2",
		"typedoc": "^0.28.17",
		"@types/bun": "latest"
	}
}