{
	"name": "tieba.js",
	"version": "3.1.2",
	"type": "module",
	"author": "Dilettante258",
	"license": "ISC",
	"keywords": [
		"tieba",
		"protobuf",
		"node.js",
		"baidu"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/Dilettante258/tieba.js"
	},
	"homepage": "http://sdk.eztb.org/",
	"bugs": {
		"url": "https://github.com/Dilettante258/tieba.js/issues"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"proto:gen": "bun run scripts/proto-gen.ts",
		"typecheck": "tsc --noEmit",
		"test": "bun test test/*.test.ts",
		"test:integration": "bun test test/integration/",
		"docs": "typedoc"
	},
	"dependencies": {
		"@bufbuild/protobuf": "^2.11.0",
		"effect": "^3.14.11",
		"long": "^5.2.4",
		"node-html-parser": "^7.0.2",
		"undici": "^7.8.0"
	},
	"devDependencies": {
		"ts-proto": "^2",
		"typedoc": "^0.28.17",
		"@types/bun": "latest"
	}
}
